# Backend API URL for local development
VITE_API_BASE_URL=http://localhost:8000/api

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=huesapply-mvp.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=huesapply-mvp
VITE_FIREBASE_STORAGE_BUCKET=huesapply-mvp.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Note: Firebase Authentication is configured for email/password authentication only

# Docker Environment
NODE_ENV=development
CHOKIDAR_USEPOLLING=true
